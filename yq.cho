format = 1
name = "yq"
version = "4.54.1"
description = "Portable command-line YAML, JSON, XML, CSV, TOML and properties processor"
license = "MIT"
homepage = "https://github.com/mikefarah/yq"
platforms = ["linux", "macos"]
architectures = ["x86_64", "arm64"]

