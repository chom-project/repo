format = 1
name = "transmission"
version = "4.1.3"
description = "Easy and efficient BitTorrent client."
license = "GPL-3.0-or-later"
homepage = "https://transmissionbt.com/"
platforms = ["macos", "linux"]
architectures = ["x86_64", "arm64"]

[source]
url = "https://github.com/transmission/transmission/releases/download/4.1.3/Transmission-4.1.3.dmg"
sha256 = "d622736c19990262f2ab12183e1acaa5b0dad5777ddc7db0a187c06e035a7e1a"
archive = "dmg"
strip_components = 0

[build]
system = "prebuilt"

[install.launchers]
"transmission" = "Transmission.app"

[platform.macos]
architectures = ["x86_64", "arm64"]

[platform.macos.x86_64.source]
url = "https://github.com/transmission/transmission/releases/download/4.1.3/Transmission-4.1.3.dmg"
sha256 = "d622736c19990262f2ab12183e1acaa5b0dad5777ddc7db0a187c06e035a7e1a"
archive = "dmg"
strip_components = 0

[platform.macos.x86_64.install.launchers]
"transmission" = "Transmission.app"

[platform.macos.arm64.source]
url = "https://github.com/transmission/transmission/releases/download/4.1.3/Transmission-4.1.3.dmg"
sha256 = "d622736c19990262f2ab12183e1acaa5b0dad5777ddc7db0a187c06e035a7e1a"
archive = "dmg"
strip_components = 0

[platform.macos.arm64.install.launchers]
"transmission" = "Transmission.app"

[platform.linux]
architectures = ["x86_64", "arm64"]

[platform.linux.source]
url = "https://github.com/transmission/transmission/releases/download/4.1.3/transmission-4.1.3.tar.xz"
sha256 = "ce7d2d8b101f7eb54bc3cf0bc55f52f7ebd4a25fa48e00bdca9a7e0fc02617da"
archive = "tar"
strip_components = 1

[platform.linux.build]
system = "cmake"
configure_args = ["-S", ".", "-B", ".chom-build", "-DENABLE_GTK=ON", "-DENABLE_MAC=OFF", "-DENABLE_QT=OFF", "-DENABLE_DAEMON=OFF", "-DENABLE_CLI=OFF", "-DENABLE_UTILS=OFF", "-DENABLE_NLS=OFF", "-DCMAKE_BUILD_TYPE=Release"]
build_args = ["--build", ".chom-build", "--target", "transmission-gtk", "--parallel"]
install_args = ["--install", ".chom-build"]

[platform.linux.install.launchers]
transmission = "bin/transmission-gtk"

