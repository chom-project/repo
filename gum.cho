format = 1
name = "gum"
version = "2.0.2"
description = "Tool for glamorous shell scripts"
license = "MIT"
homepage = "https://github.com/charmbracelet/gum"
platforms = ["linux", "macos", "windows"]
architectures = ["x86_64", "arm64"]

[source]
url = "https://github.com/charmbracelet/gum/releases/download/v2.0.2/gum_2.0.2_Linux_x86_64.tar.gz"
sha256 = "d842e06d93dbed90af48cb8dd10698db6f22e331fc40346bb37bbc753109edc2"
archive = "tar.gz"
strip_components = 0

[build]
system = "prebuilt"

[install.launchers]
"gum" = "gum_2.0.2_Linux_x86_64/gum"

[platform.linux]
architectures = ["x86_64", "arm64"]

[platform.linux.x86_64.source]
