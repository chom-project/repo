format = 1
name = "rclone"
version = "1.75.2"
description = "Command-line program to manage files on cloud storage"
license = "MIT"
homepage = "https://github.com/rclone/rclone"
platforms = ["linux", "macos"]
architectures = ["x86_64", "arm64"]

