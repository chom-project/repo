format = 1
name = "zoxide"
version = "0.10.0"
description = "Smarter directory-jumping utility inspired by z and autojump."
license = "MIT"
homepage = "https://github.com/ajeetdsouza/zoxide"
platforms = ["linux", "macos", "windows"]
architectures = ["x86_64", "arm64"]

