format = 1
name = "vlc"
version = "3.0.24"
description = "Free and open-source multimedia player."
license = "GPL-2.0-or-later"
homepage = "https://www.videolan.org/vlc/"
platforms = ["macos", "windows"]
architectures = ["x86_64", "arm64"]

[source]
url = "https://get.videolan.org/vlc/3.0.24/macosx/vlc-3.0.24-intel64.dmg"
sha256 = "1ef6c903e2dc026d4e58ddf7b2a9ed0eb6f8caf80a9a9f46f96490340b962707"
archive = "dmg"
strip_components = 0

[build]
system = "prebuilt"

[install.launchers]
"vlc" = "VLC.app"

[platform.macos]
architectures = ["x86_64", "arm64"]

[platform.macos.x86_64.source]
