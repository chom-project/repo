archive = "dmg"
strip_components = 0

[platform.macos.x86_64.install.launchers]
"vlc" = "VLC.app"

[platform.macos.arm64.source]
url = "https://get.videolan.org/vlc/3.0.24/macosx/vlc-3.0.24-arm64.dmg"
sha256 = "64a89d93cdd30b0e97131743e246373db82d6826ea882d265d46d74b136da2b7"
archive = "dmg"
strip_components = 0

[platform.macos.arm64.install.launchers]
