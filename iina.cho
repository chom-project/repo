format = 1
name = "iina"
version = "1.5.0"
description = "Free and open-source media player for macOS."
license = "GPL-3.0-or-later"
homepage = "https://iina.io/"
platforms = ["macos"]
architectures = ["x86_64", "arm64"]

[source]
url = "https://dl.iina.io/IINA.v1.5.0.dmg"
sha256 = "8fad50479b10e09645053457cec46bd53d054ced2242cfe68f74586735a20dc7"
archive = "dmg"
strip_components = 0

[build]
system = "prebuilt"

[install.launchers]
"iina" = "IINA.app"

[platform.macos]
architectures = ["x86_64", "arm64"]

[platform.macos.x86_64.source]
url = "https://dl.iina.io/IINA.v1.5.0.dmg"
sha256 = "8fad50479b10e09645053457cec46bd53d054ced2242cfe68f74586735a20dc7"
archive = "dmg"
strip_components = 0

[platform.macos.x86_64.install.launchers]
"iina" = "IINA.app"

[platform.macos.arm64.source]
url = "https://dl.iina.io/IINA.v1.5.0.dmg"
sha256 = "8fad50479b10e09645053457cec46bd53d054ced2242cfe68f74586735a20dc7"
archive = "dmg"
strip_components = 0

[platform.macos.arm64.install.launchers]
"iina" = "IINA.app"

