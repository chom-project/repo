format = 1
name = "libreoffice"
version = "26.8.1"
description = "Free office suite for documents, spreadsheets, and presentations."
license = "MPL-2.0"
homepage = "https://www.libreoffice.org/"
platforms = ["macos"]
architectures = ["x86_64", "arm64"]

[source]
url = "https://download.documentfoundation.org/libreoffice/stable/26.8.1/mac/x86_64/LibreOffice_26.8.1_MacOS_x86-64.dmg"
sha256 = "4c7464313a529e9074400cbcdc894fc40ac4ef9421ded03b16b5a78d12cb155e"
archive = "dmg"
strip_components = 0

[build]
system = "prebuilt"

[install.launchers]
"libreoffice" = "LibreOffice.app"

[platform.macos]
architectures = ["x86_64", "arm64"]

[platform.macos.x86_64.source]
url = "https://download.documentfoundation.org/libreoffice/stable/26.8.1/mac/x86_64/LibreOffice_26.8.1_MacOS_x86-64.dmg"
sha256 = "4c7464313a529e9074400cbcdc894fc40ac4ef9421ded03b16b5a78d12cb155e"
archive = "dmg"
strip_components = 0

[platform.macos.x86_64.install.launchers]
"libreoffice" = "LibreOffice.app"

[platform.macos.arm64.source]
url = "https://download.documentfoundation.org/libreoffice/stable/26.8.1/mac/aarch64/LibreOffice_26.8.1_MacOS_aarch64.dmg"
sha256 = "ca074e0b13571efb30a31fc531c5f95e997030637325e5d5de92d67aefdf0dfc"
archive = "dmg"
strip_components = 0

[platform.macos.arm64.install.launchers]
