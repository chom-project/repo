archive = "tar.gz"
strip_components = 1

[platform.linux.x86_64.install.launchers]
"nvim" = "bin/nvim"

[platform.linux.arm64.source]
url = "https://github.com/neovim/neovim/releases/download/v0.12.6/nvim-linux-arm64.tar.gz"
sha256 = "8f1f64a0bdb97247034038c3823c6cbad5bdf9ecd5751b85494b71c3ee04c815"
archive = "tar.gz"
strip_components = 1

[platform.linux.arm64.install.launchers]
"nvim" = "bin/nvim"

[platform.macos]
architectures = ["x86_64", "arm64"]

[platform.macos.x86_64.source]
