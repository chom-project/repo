sha256 = "eae378083774b6d379c328c71989b764fa960e5e4265236e0fc58b8a08014a64"
archive = "zip"
strip_components = 0

[platform.macos.x86_64.install.launchers]
"telegram" = "Telegram.app"

[platform.macos.arm64.source]
url = "https://osx.telegram.org/updates/Telegram-13.0.283305.app.zip"
sha256 = "eae378083774b6d379c328c71989b764fa960e5e4265236e0fc58b8a08014a64"
archive = "zip"
strip_components = 0

[platform.macos.arm64.install.launchers]
"telegram" = "Telegram.app"


[platform.linux]
version = "7.3.1"
architectures = ["x86_64"]

[platform.linux.source]
url = "https://td.telegram.org/linux-x64/td-setup-linux-x64-7.3.1.tar.xz"
sha256 = "654a5b266d653b072b4407a4644bd441e37ee393f502c71b2e1d86fc115b8ab6"
archive = "tar.xz"
strip_components = 1

[platform.linux.install.launchers]
telegram = "Telegram"
