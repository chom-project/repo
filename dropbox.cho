sha256 = "4f1c9b70a47ed57a2d45c3e37e0440465b08375785ea39321ba1e545635b3774"
archive = "dmg"
strip_components = 0

[build]
system = "prebuilt"

[install.launchers]
"dropbox" = "Dropbox.app"

