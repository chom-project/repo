format = 1
name = "dropbox"
version = "274.4.4905"
description = "File sync and cloud storage client."
license = "Proprietary"
homepage = "https://www.dropbox.com/"
platforms = ["macos", "linux"]
architectures = ["x86_64", "arm64"]

[source]
