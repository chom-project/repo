format = 1
name = "vim"
version = "9.2.321"
description = "Highly configurable text editor."
license = "Vim"
homepage = "https://github.com/macvim-dev/macvim"
platforms = ["macos", "windows", "linux"]
architectures = ["x86_64", "arm64"]

[source]
url = "https://github.com/macvim-dev/macvim/releases/download/release-183/MacVim.dmg"
sha256 = "c27fb8948328074dcb81f45b7d88ff4e123a86c06eaf3d5b330369bc39ffab69"
archive = "dmg"
strip_components = 0

[build]
system = "prebuilt"

[platform.macos]
architectures = ["x86_64", "arm64"]

[platform.macos.x86_64.source]
url = "https://github.com/macvim-dev/macvim/releases/download/release-183/MacVim.dmg"
sha256 = "c27fb8948328074dcb81f45b7d88ff4e123a86c06eaf3d5b330369bc39ffab69"
archive = "dmg"
strip_components = 0

[platform.macos.x86_64.install.launchers]
"vim" = "MacVim.app/Contents/bin/mvim"
"mvim" = "MacVim.app/Contents/bin/mvim"

[platform.macos.arm64.source]
url = "https://github.com/macvim-dev/macvim/releases/download/release-183/MacVim.dmg"
sha256 = "c27fb8948328074dcb81f45b7d88ff4e123a86c06eaf3d5b330369bc39ffab69"
archive = "dmg"
strip_components = 0

[platform.macos.arm64.install.launchers]
"vim" = "MacVim.app/Contents/bin/mvim"
"mvim" = "MacVim.app/Contents/bin/mvim"

[platform.windows]
version = "9.2.1202"
architectures = ["x86_64", "arm64"]

[platform.windows.x86_64.source]
url = "https://github.com/vim/vim-win32-installer/releases/download/v9.2.1202/gvim_9.2.1202_x64.zip"
sha256 = "a8956f116755c4ad0995d50d2b04387d12e3bd1488306476fa61ba70c47e868e"
archive = "zip"
strip_components = 0

[platform.windows.x86_64.install.launchers]
vim = "vim/vim92/vim.exe"

[platform.windows.arm64.source]
url = "https://github.com/vim/vim-win32-installer/releases/download/v9.2.1202/gvim_9.2.1202_arm64.zip"
sha256 = "87da0c58be3d906c3020caabadaee0da36287dfec9648b6fd0a947be264d8dad"
archive = "zip"
strip_components = 0

[platform.windows.arm64.install.launchers]
vim = "vim/vim92/vim.exe"

[platform.linux]
version = "9.2.1202"
architectures = ["x86_64", "arm64"]

[platform.linux.source]
url = "https://github.com/vim/vim/archive/refs/tags/v9.2.1202.tar.gz"
sha256 = "9e97414b85bdcb2d28d5264c65dd730d86b9a75319b005c63da0bc130c715a2f"
archive = "tar.gz"
strip_components = 1

[platform.linux.build]
system = "autotools"
configure_args = ["--with-features=huge", "--enable-multibyte"]
build_args = ["-j2"]
install_args = ["-j2"]

[platform.linux.install]
binaries = ["src/vim"]
