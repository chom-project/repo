format = 1
name = "obs"
version = "32.2.2"
description = "Free software for video recording and live streaming."
license = "GPL-2.0-or-later"
homepage = "https://obsproject.com/"
platforms = ["macos", "linux", "windows"]
architectures = ["x86_64", "arm64"]

[source]
url = "https://cdn-fastly.obsproject.com/downloads/obs-studio-32.2.2-macos-intel.dmg"
sha256 = "f8d8afe3dffdc86efa0698c02ff0c997866bac3e6208ddaf56d37108baacf197"
archive = "dmg"
strip_components = 0

[build]
system = "prebuilt"

[install.launchers]
"obs" = "OBS.app"

[platform.macos]
architectures = ["x86_64", "arm64"]

[platform.macos.x86_64.source]
url = "https://cdn-fastly.obsproject.com/downloads/obs-studio-32.2.2-macos-intel.dmg"
sha256 = "f8d8afe3dffdc86efa0698c02ff0c997866bac3e6208ddaf56d37108baacf197"
archive = "dmg"
strip_components = 0

[platform.macos.x86_64.install.launchers]
"obs" = "OBS.app"

[platform.macos.arm64.source]
url = "https://cdn-fastly.obsproject.com/downloads/obs-studio-32.2.2-macos-apple.dmg"
sha256 = "920d6f26703d2df6e4085bd3c1cbed30488325084136c7a6e9e37021fbd6aaf7"
archive = "dmg"
strip_components = 0

[platform.macos.arm64.install.launchers]
"obs" = "OBS.app"

[platform.linux]
architectures = ["x86_64", "arm64"]

[platform.linux.source]
url = "https://github.com/obsproject/obs-studio/archive/refs/tags/32.2.2.tar.gz"
sha256 = "35d3cd0979d65664fada7119fdb612eca7c34b61a1623a330caec74bf72626c4"
archive = "tar.gz"
strip_components = 1

[platform.linux.build]
system = "cmake"
configure_args = ["-S", ".", "-B", ".chom-build", "-DENABLE_BROWSER=OFF", "-DCMAKE_BUILD_TYPE=Release"]
build_args = ["--build", ".chom-build", "--parallel"]
install_args = ["--install", ".chom-build"]

[platform.linux.install.launchers]
obs = "bin/obs"

[platform.windows]
architectures = ["x86_64", "arm64"]

[platform.windows.x86_64.source]
url = "https://github.com/obsproject/obs-studio/releases/download/32.2.2/OBS-Studio-32.2.2-Windows-x64.zip"
sha256 = "4d6e40e3ab155f56b30de517380566a206d74b63cdf5ad49aa596924768f97e1"
archive = "zip"
strip_components = 0

[platform.windows.x86_64.install.launchers]
obs = "bin/64bit/obs64.exe"

[platform.windows.arm64.source]
url = "https://github.com/obsproject/obs-studio/releases/download/32.2.2/OBS-Studio-32.2.2-Windows-arm64.zip"
sha256 = "b16b41c3cf89b8a919738359a46acb25d207ec1e488563139d7c276cfffb0906"
archive = "zip"
strip_components = 0

[platform.windows.arm64.install.launchers]
obs = "bin/64bit/obs64.exe"

